module Weight_Memory #(
    parameter NUM_NEURONS = 3,
    parameter NUM_INPUTS = 4,
    parameter DATA_WIDTH = 8,
    parameter WEIGHT_FILE = "weights.mem"  // Pre-trained weights
)(
    input wire clk,
    input wire reset_n,
    input wire [1:0] neuron_addr,    // 0-2: Which neuron
    input wire [1:0] weight_addr,    // 0-3: Which weight within neuron
    output reg signed [DATA_WIDTH-1:0] weight_out
);

// ============================================
// Pre-trained Weight Storage
// ============================================
// Organized as: 3 neurons × 4 weights each = 12 total weights
// Memory initialization from pre-trained values
reg signed [DATA_WIDTH-1:0] weights [0:NUM_NEURONS-1][0:NUM_INPUTS-1];

// Example: Pre-trained weights for a simple ultrasonic classifier
// These would come from your Python/ML training
initial begin
    // Neuron 0: Safe classifier weights
    weights[0][0] = 8'h0A;  // Front sensor weight
    weights[0][1] = 8'h08;  // Left sensor weight  
    weights[0][2] = 8'h08;  // Right sensor weight
    weights[0][3] = 8'h06;  // Rear sensor weight
    
    // Neuron 1: Warning classifier weights
    weights[1][0] = 8'h14;  // More sensitive to front
    weights[1][1] = 8'h0C;  // Medium left sensitivity
    weights[1][2] = 8'h0C;  // Medium right sensitivity
    weights[1][3] = 8'h08;  // Lower rear sensitivity
    
    // Neuron 2: Danger classifier weights
    weights[2][0] = 8'h20;  // Very sensitive to front
    weights[2][1] = 8'h10;  // High left sensitivity
    weights[2][2] = 8'h10;  // High right sensitivity
    weights[2][3] = 8'h0A;  // Medium rear sensitivity
end

// Alternative: Load from memory file (for synthesis)
// initial $readmemh(WEIGHT_FILE, weights);

// ============================================
// Read Logic
// ============================================
always @(posedge clk or negedge reset_n) begin
    if (!reset_n) begin
        weight_out <= 0;
    end else begin
        // Read weight for specific neuron and input
        weight_out <= weights[neuron_addr][weight_addr];
    end
end

endmodule