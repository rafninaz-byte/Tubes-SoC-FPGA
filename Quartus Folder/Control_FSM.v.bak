module Control_FSM (
    input wire clk,
    input wire reset_n,
    input wire start,
    output reg mac_enable,
    output reg accum_clear,
    output reg act_enable,
    output reg [1:0] weight_addr,
    output reg [1:0] neuron_sel,
    output reg ready
);

// State encoding
typedef enum logic [2:0] {
    IDLE,
    LOAD_INPUTS,
    COMPUTE_START,
    COMPUTE_RUN,
    ACTIVATE,
    DONE
} state_t;

state_t current_state, next_state;
reg [3:0] cycle_counter;

always @(posedge clk or negedge reset_n) begin
    if (!reset_n) begin
        current_state <= IDLE;
        cycle_counter <= 0;
    end else begin
        current_state <= next_state;
        
        if (current_state == COMPUTE_RUN)
            cycle_counter <= cycle_counter + 1;
        else
            cycle_counter <= 0;
    end
end

always @(*) begin
    // Default outputs
    mac_enable = 0;
    accum_clear = 0;
    act_enable = 0;
    weight_addr = 0;
    neuron_sel = 0;
    ready = 0;
    next_state = current_state;
    
    case (current_state)
        IDLE: begin
            ready = 1;
            if (start)
                next_state = LOAD_INPUTS;
        end
        
        LOAD_INPUTS: begin
            next_state = COMPUTE_START;
        end
        
        COMPUTE_START: begin
            accum_clear = 1;  // Clear accumulators and load biases
            next_state = COMPUTE_RUN;
        end
        
        COMPUTE_RUN: begin
            mac_enable = 1;
            weight_addr = cycle_counter[1:0];  // Cycle through 4 weights
            
            if (cycle_counter == 3)  // After 4 cycles
                next_state = ACTIVATE;
        end
        
        ACTIVATE: begin
            act_enable = 1;
            next_state = DONE;
        end
        
        DONE: begin
            ready = 1;
            next_state = IDLE;
        end
    endcase
end

endmodule