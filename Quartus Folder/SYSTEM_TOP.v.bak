module SYSTEM_TOP (
    input  wire        clk,        // 50 MHz
    input  wire        rst,        // active-high reset

    // HC-SR04 interface
    input  wire [3:0]  echo,
    output wire [3:0]  trig,

    // Output
    output wire [2:0]  LED
);

    // ==========================================
    // Ultrasonic distance outputs (cm)
    // ==========================================
    wire [15:0] dist0, dist1, dist2, dist3;

    Ultrasonic_Accelerator US (
        .clk(clk),
        .reset_n(~rst),
        .echo(echo),
        .trig(trig),
        .distance_cm0(dist0),
        .distance_cm1(dist1),
        .distance_cm2(dist2),
        .distance_cm3(dist3)
    );

    // ==========================================
    // Scaling: distance (cm) → INT8 feature
    // ==========================================
    wire signed [7:0] x0, x1, x2, x3;

    Distance_To_INT8 S0 (.dist_cm(dist0), .x(x0));
    Distance_To_INT8 S1 (.dist_cm(dist1), .x(x1));
    Distance_To_INT8 S2 (.dist_cm(dist2), .x(x2));
    Distance_To_INT8 S3 (.dist_cm(dist3), .x(x3));

    // ==========================================
    // Neural Network Accelerator
    // ==========================================
    wire [1:0] class_id;
    wire       done;

    NNA_TOP NN (
        .clk(clk),
        .rst(rst),
        .start(1'b1),   // continuous inference
        .x0(x0),
        .x1(x1),
        .x2(x2),
        .x3(x3),
        .class_id(class_id),
        .done(done),
        .LED(LED)
    );

endmodule
