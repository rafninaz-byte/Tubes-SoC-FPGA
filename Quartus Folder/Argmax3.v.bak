module Argmax3 (
    input  wire signed [15:0] y0,
    input  wire signed [15:0] y1,
    input  wire signed [15:0] y2,
    output reg  [1:0] class_id
);

always @(*) begin
    if (y0 >= y1 && y0 >= y2)
        class_id = 2'd0;   // SAFE
    else if (y1 >= y2)
        class_id = 2'd1;   // WARNING
    else
        class_id = 2'd2;   // DANGER
end

endmodule
