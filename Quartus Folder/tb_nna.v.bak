module tb_nna;

    reg clk = 0;
    reg rst = 1;
    reg start = 0;

    reg signed [7:0] x0, x1, x2, x3;
    wire [1:0] class_id;
    wire done;

    // Clock
    always #10 clk = ~clk; // 50 MHz

    NNA_TOP dut (
        .clk(clk),
        .rst(rst),
        .start(start),
        .x0(x0),
        .x1(x1),
        .x2(x2),
        .x3(x3),
        .class_id(class_id),
        .neuron_done(done)
    );

    initial begin
        // Reset
        #100;
        rst = 0;

        // Test vector from Python
        x0 = 8'd13;
        x1 = 8'd76;
        x2 = 8'd24;
        x3 = 8'd82;

        #20 start = 1;
        #20 start = 0;

        // Wait for NN
        wait(done);

        $display("Class = %d", class_id);
        #100 $stop;
    end
endmodule
